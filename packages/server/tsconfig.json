{
  // 继承仓库根目录的 tsconfig.base.json 公共编译配置
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 编译产物输出到 dist 目录
    "outDir": "dist",
    // 源码根目录为 src
    "rootDir": "src",
    // 可用的标准库 API 类型按 ES2022 提供
    "lib": ["ES2022"]
  },
  // 只编译 src 目录
  "include": ["src"],
  // server 同时直接 import 了 shared / services / client / rpc。
  // 之前 references 不完整，构建时会退回到沿着包入口抓源码，造成 rpc 报错被重复放大。
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../client" },
    { "path": "../rpc" }
  ]
}
