{
  // ============================================================================
  // 本文件是 model-option-map 包（模型选项映射数据/工具）的 TS 配置。
  // 继承根基座，这里只写本包覆盖项。
  // ============================================================================
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 编译产物输出到 dist。
    "outDir": "dist",
    // 源码根目录为 src。
    "rootDir": "src",
    // 覆盖基座：标准库类型升级到 ES2025。
    "lib": ["ES2025"]
  },
  // 只编译 src 目录。
  "include": ["src"]
}
