{
  // 继承仓库根目录的 tsconfig.base.json 公共编译配置
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 编译产物输出到 dist 目录
    "outDir": "dist",
    // 源码根目录为 src
    "rootDir": "src",
    // 可用类型：ES2025 标准库 + 浏览器 DOM
    "lib": ["ES2025", "DOM"],
    // 开启全套严格类型检查（base 里未开 strict，这里单独启用）
    "strict": true
  },
  // 只编译 src 目录
  "include": ["src"]
}
