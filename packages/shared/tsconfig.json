{
  // ============================================================================
  // 本文件是 shared 包（跨端共享的协议与类型定义）的 TS 配置。
  // 继承根基座，这里只写本包特有覆盖项。
  // ============================================================================
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 编译产物输出到 dist，与源码分离，供其他包按声明产物消费。
    "outDir": "dist",
    // 源码根目录为 src。
    "rootDir": "src",
    // 显式加载 @types/node：shared 虽以纯类型/协议为主，但部分工具代码
    // 用到 Node 全局类型（路径处理、process 等），不加载会报「找不到名称 process」。
    "types": ["node"],
    // allowJs：允许把 .js 文件也纳入编译/检查范围。
    // 默认 tsc 只认 .ts/.tsx；开启后 src 里若有历史遗留的 .js（或从外部
    // 拷贝来的 JS 工具），也会被一起解析、随产物输出，并能被 .ts 文件导入。
    //   import { legacy } from './legacy.js'   // 该 .js 文件存在时不再报找不到模块
    "allowJs": true
  },
  // 只编译 src 目录。
  "include": ["src"]
}
