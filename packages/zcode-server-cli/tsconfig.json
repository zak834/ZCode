{
  // ============================================================================
  // 本文件是 zcode-server-cli 包（服务端 CLI 启动器）的 TS 编译配置。
  // 它「继承」根目录的 tsconfig.base.json：基座里已开启的选项（严格索引、
  // 声明文件、ESM 互操作等）自动生效，这里只写【本包与基座不同】的覆盖项。
  // 类比：基座是「全校通用校规」，这里是「本班的补充规定」。
  // ============================================================================
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // --- 源码与产物的目录对应关系 ---
    // rootDir：声明「源码的根目录」是 src。编译时 TS 以它为起点计算相对路径，
    // 例如 src/cli/main.ts 编译后会变成 dist/cli/main.js（src 前缀被剥掉）。
    // 若有文件在 rootDir 之外却被纳入编译，TS 会直接报错，防止产物目录结构错乱。
    "rootDir": "src",
    // outDir：编译产物（.js/.d.ts/.map）统一写到 dist 目录，和源码分开，
    // 便于发布打包（只发 dist）与清理（删 dist 不会动源码）。
    "outDir": "dist",
    // --- 本包能用哪些「内置 API 类型」 ---
    // lib 覆盖基座的 ["es2024"]：本包运行在 Node 端但会处理 DOM 相关数据结构，
    // 所以除 ES2022 标准库（Promise、Map、Array 新方法等类型）外，再加 "DOM"，
    // 让 document、HTMLElement 等浏览器类型也可用于类型位置（不代表运行时存在）。
    "lib": ["ES2022", "DOM"],
    // types：从 node_modules/@types/ 下【显式点名】要加载的全局类型包。
    // 写了 ["node"] 后，TS 才认识 process、Buffer、__dirname 等 Node 全局量；
    // 一旦显式写了 types，其他 @types/* 包就不会被自动全局加载（按需导入即可）。
    "types": ["node"]
  },
  // include：圈定「哪些文件属于本工程」。这里只收 src 目录，
  // 目录外的脚本、测试临时文件不会被类型检查，也不会进产物。
  "include": ["src"],
  // references：声明本工程依赖的【其他 TS 工程】。tsc -b 做类型检查时，
  // 会先确保这三个包构建好，本包直接读取它们产出的 .d.ts 声明文件，
  // 而不会把它们的 .ts 源码拖进本工程重复检查（重复检查会让错误被打印多次、
  // 且可能因配置不同而产生不一致的检查结果）。
  "references": [{ "path": "../shared" }, { "path": "../rpc" }, { "path": "../services" }]
}
