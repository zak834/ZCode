{
  // 继承仓库根目录的 tsconfig.base.json 公共编译配置
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 产物输出到 out/main
    "outDir": "out/main",
    // 源码根目录为 src/main
    "rootDir": "src/main",
    // 可用的标准库 API 类型按 ES2025 提供（主进程是纯 Node 环境）
    "lib": ["es2025"]
  },
  // 只编译 src/main 目录
  "include": ["src/main"],
  // main 直接依赖 shared 和 services；把引用补齐后，desktop 子工程也能稳定复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
