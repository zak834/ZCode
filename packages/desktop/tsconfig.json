{
  // ============================================================================
  // 本文件是 desktop 包（Electron 桌面端）的「解决方案入口」配置。
  // Electron 应用包含多个运行环境完全不同的部分（主进程/宿主/调度器/
  // preload/渲染进程），它们的编译选项各不相同，所以拆成 5 个子工程。
  // 本文件自己【不编译任何源码】，只负责把 5 个子工程聚合成一组，
  // 让 tsc -b（pnpm typecheck）一条命令按依赖顺序全部构建。
  // ============================================================================

  // files：显式列出要编译的文件；这里给空数组，表示「本工程没有自己的输入文件」。
  // 若不写 files 也不写 include，tsc 会默认把目录下所有 .ts 都收进来，
  // 那就和 5 个子工程重复了，所以必须为空。
  "files": [],
  // references：列出聚合的子工程。tsc -b 会读取每个子工程的配置，
  // 按它们之间的依赖拓扑排序构建，并用 .tsbuildinfo 做增量缓存。
  "references": [
    // Electron 主进程：窗口创建、原生操作、进程调度与消息转发（纯 Node 环境）
    { "path": "./tsconfig.main.json" },
    // Local Host：Agent 会话运行时的宿主进程（纯 Node 环境）
    { "path": "./tsconfig.host.json" },
    // 调度器：子进程调度相关逻辑
    { "path": "./tsconfig.scheduler.json" },
    // 预加载脚本：渲染进程创建前注入，是连接渲染进程与主进程的安全桥
    { "path": "./tsconfig.preload.json" },
    // 渲染进程：React 界面（Chromium 浏览器环境）
    { "path": "./tsconfig.renderer.json" }
  ]
}
