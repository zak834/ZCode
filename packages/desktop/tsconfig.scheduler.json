{
  // 继承仓库根目录的 tsconfig.base.json 公共编译配置
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 产物输出到 out/scheduler
    "outDir": "out/scheduler",
    // 源码根目录为 src/scheduler
    "rootDir": "src/scheduler",
    // 可用的标准库 API 类型按 ES2025 提供
    "lib": ["es2025"],
    // scheduler 只把 Electron.MessageEvent 当类型用、不 import "electron" 值，
    // 故显式引入 node + electron 全局类型（process/setInterval/Electron 命名空间）。
    "types": ["node", "electron"]
  },
  // 只编译 src/scheduler 目录
  "include": ["src/scheduler"],
  // scheduler 直接依赖 services(node 入口)/shared；补 references 复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
