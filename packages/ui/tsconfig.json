{
  // ============================================================================
  // 本文件是 ui 包（桌面/Web 共享的 React 组件、hooks 与 Zustand store）的
  // TS 配置。继承根基座，这里只写本包特有覆盖项。
  // ============================================================================
  "extends": "../../tsconfig.base.json",
  // ui 包沿用 NodeNext 的 ESM 解析规则，包内导入必须能直接落到真实文件路径。
  // 之前 ai-elements 一边从包内部自引用 @zcode/ui/...，一边大量省略内部 .js 后缀，
  // 会同时踩中 package exports 限制和 NodeNext 的路径解析失败。
  // 这里保留现有配置，把包内导入统一收敛到带 .js 后缀的相对路径，避免开发态、构建态和类型检查结果不一致。
  "compilerOptions": {
    // 产物假设输出到 dist（本包由打包链路消费，路径配置保持与其他包一致）。
    "outDir": "dist",
    // 源码根目录为 src。
    "rootDir": "src",
    // 浏览器环境类型：ES2025 标准库 + DOM API + 可迭代的 DOM 集合
    // （NodeList 等能用 for...of），供组件代码操作浏览器对象。
    "lib": ["es2025", "dom", "dom.iterable"],
    // React 17+ 自动 JSX 转换，.tsx 中写 <Button/> 无需 import React。
    "jsx": "react-jsx",
    // paths：自定义「路径别名」。编译/检查时凡是以 @/ 开头的导入说明符，
    // 都映射到 ./src/ 下对应文件：
    //   import { x } from '@/hooks/useX'  →  解析为 ./src/hooks/useX
    // 好处：文件移动层级时不用写一长串 ../../..。注意它只影响 TS 的类型解析，
    // Vite/打包器侧需配置等价别名才能在运行时生效（两边要保持同步）。
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // 某些 tsserver/增量工程状态下，目录式 include（"src"）会出现新文件已存在、
  // 也能被 CLI `tsc --showConfig` 展开，但编辑器仍短暂报“文件不在 project file list”。
  // 这里改成显式 glob，强制把 ui 包下的 ts/tsx/d.ts 源文件稳定纳入工程，避免设置页辅助文件这类新增模块被误判漏收录。
  // 同时纳入 src 下的 .json（如 assets 下的 provider-icons 数据），让 resolveJsonModule 导入能被工程文件列表收录。
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.json"],
  // ui 里也直接用了 rpc 的类型；补上工程引用后，ui 不会再把 rpc 源码当成自己的输入重新检查。
  "references": [
    { "path": "../provider" },
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" }
  ]
}
