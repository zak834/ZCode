{
  // ============================================================================
  // dynamic-workflow-runtime 包（动态工作流的运行时执行器）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座；与 dynamic-workflow 保持同一套
  // ES2022 + 索引收紧基线，保证「定义侧」和「执行侧」类型行为一致。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物语法与可用标准库均为 ES2022。
    "target": "ES2022",
    "lib": ["ES2022"],
    // 产物目录与源码根目录。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 运行时按下标取节点/步骤的结果自动带 undefined，强制先判空再执行，
    // 避免缺节点时沿 undefined 继续调度。
    "noUncheckedIndexedAccess": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖目录与历史产物。
  "exclude": ["node_modules", "dist"]
}
