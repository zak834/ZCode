{
  // ============================================================================
  // tui 包（CLI 的终端用户界面，用 React/Ink 之类渲染终端组件）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座；它是【会产出 JS 和声明】的库包。
  // ============================================================================
  "compilerOptions": {
    // --- 模块：Node 运行的 ESM ---
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // --- 目录 ---
    // 产物写到 dist；源码根是 src（src/a/x.ts → dist/a/x.js）。
    "outDir": "./dist",
    "rootDir": "./src",
    // --- 声明产物：作为库要给消费方提供类型 ---
    "declaration": true, // 生成 .d.ts 类型声明
    "declarationMap": true, // 生成 .d.ts.map，支持从声明跳回源码
    // --- 互操作与跨平台 ---
    "esModuleInterop": true, // 自然 default 导入 CommonJS 包
    "forceConsistentCasingInFileNames": true, // 导入大小写必须与文件名一致（防 Windows→Linux 翻车）
    // --- JSX：终端组件同样用 React JSX 语法 ---
    // react-jsx：自动注入 jsx 运行时，文件里不用 import React。
    "jsx": "react-jsx",
    // --- 检查 ---
    "strict": true, // 全套严格类型检查
    "skipLibCheck": true, // 不检查第三方声明文件
    "types": ["node"] // 加载 Node 全局类型
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"]
}
