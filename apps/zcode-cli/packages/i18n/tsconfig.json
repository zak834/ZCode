{
  // ============================================================================
  // i18n 包（国际化文案与语言资源）的 TS 配置。嵌套 workspace 独立配置，
  // 不继承根基座；目标语法显式定为 ES2022（比其他包的 ES2024 更保守，
  // 兼容稍旧的 Node 运行时），并额外收紧索引访问。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物 JS 语法级别 ES2022（类字段、顶层 await 等原样输出，不降级到更老）。
    "target": "ES2022",
    // 可用标准库类型同样按 ES2022 提供，保证「检查允许的 API」与「目标运行时
    // 支持的语法」一致，不会写出目标环境没有的 API。
    "lib": ["ES2022"],
    // 产物目录与源码根目录。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 额外收紧下标访问：messages[key] 可能拿不到文案，结果类型带 undefined，
    // 强制先处理「缺翻译」的情况再使用，避免渲染出 undefined。
    "noUncheckedIndexedAccess": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖目录与历史产物。
  "exclude": ["node_modules", "dist"]
}
