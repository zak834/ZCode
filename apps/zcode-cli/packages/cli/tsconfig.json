{
  // ============================================================================
  // cli 包（zcode 命令行入口）的 TS 配置。嵌套 workspace 独立配置，
  // 不继承根基座。这是【最小配置】：不设 outDir/rootDir/declaration，
  // 因为入口包通常由外层打包/发行流程统一处理产物，这里只需保证类型检查正确。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则（相对导入带 .js 后缀）。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 补齐 CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 检查 src 下所有 TS 文件。
  "include": ["src/**/*"]
}
