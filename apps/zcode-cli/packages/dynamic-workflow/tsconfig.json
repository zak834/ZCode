{
  // ============================================================================
  // dynamic-workflow 包（动态工作流定义）的 TS 配置。嵌套 workspace 独立配置，
  // 不继承根基座；目标 ES2022，并额外收紧索引访问（工作流节点常按下标/键取）。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物语法与可用标准库均为 ES2022（检查范围与目标运行时能力对齐）。
    "target": "ES2022",
    "lib": ["ES2022"],
    // 产物目录与源码根目录。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // nodes[i]、map[key] 的结果自动带 undefined，强制判空，
    // 防止工作流中「节点不存在」被当成有效节点继续执行。
    "noUncheckedIndexedAccess": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖目录与历史产物。
  "exclude": ["node_modules", "dist"]
}
