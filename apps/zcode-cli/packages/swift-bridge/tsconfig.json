{
  // ============================================================================
  // swift-bridge 包（与 Swift 侧原生能力桥接相关代码）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座；标准 Node 库包。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物写到 dist，源码根为 src。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射，供消费方获得类型、可跳回源码。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制与文件名一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"]
}
