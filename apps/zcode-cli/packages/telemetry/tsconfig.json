{
  // ============================================================================
  // telemetry 包（遥测/埋点上报）的 TS 配置。嵌套 workspace 独立配置，
  // 不继承根基座；标准 Node 库包，产出 JS 与类型声明到 dist。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则（相对导入带 .js 后缀）。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物目录与源码根目录（产物剥去 src 前缀落盘）。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成 .d.ts 与 .d.ts.map：供其他包导入时获得类型提示并能跳回源码。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写与文件名强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"]
}
