{
  // ============================================================================
  // node-repl-host 包（Node REPL 宿主能力）的 TS 配置。嵌套 workspace 独立
  // 配置，不继承根基座；标准 Node 库包，产出 JS 与声明到 dist。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物目录与源码根目录。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖目录与历史产物，避免把 dist 里的旧 JS 再次当输入编译。
  "exclude": ["node_modules", "dist"]
}
