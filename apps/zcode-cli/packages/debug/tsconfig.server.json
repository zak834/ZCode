{
  // ============================================================================
  // debug 包的【服务端】配置：与调试面板配套、跑在 Node 里的服务进程。
  // 与 tsconfig.json（面板，noEmit + DOM + Vite）刻意分开，互不污染类型环境。
  // 嵌套 workspace 独立配置，不继承根基座。
  // ============================================================================
  "compilerOptions": {
    // 类型层面允许默认导入。
    "allowSyntheticDefaultImports": true,
    // declaration:false：不生成 .d.ts。服务端产物只给自己运行，不对外提供类型。
    "declaration": false,
    // 补齐 CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写与文件名强制一致。
    "forceConsistentCasingInFileNames": true,
    // 每个文件可被独立转译。
    "isolatedModules": true,
    // 纯 Node：只给 ES2024 标准库类型，不加 DOM（避免误用浏览器 API）。
    "lib": ["ES2024"],
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 显式允许产出 JS（与面板配置的 noEmit:true 对照）。
    "noEmit": false,
    // switch 漏 break 贯穿时报错。
    "noFallthroughCasesInSwitch": true,
    // 重写父类方法必须写 override。
    "noImplicitOverride": true,
    // 下标访问结果带 undefined，强制判空。
    "noUncheckedIndexedAccess": true,
    // 产物输出到 dist-server，与面板的 dist 明确区分，避免互相覆盖。
    "outDir": "dist-server",
    // rootDir 是包根「.」而不是 src：因为输入同时来自 server/、scripts/
    // 和 src/shared.ts 三个并列位置，根必须是它们的公共祖先目录。
    "rootDir": ".",
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // 全套严格类型检查。
    "strict": true,
    // 产物语法目标 ES2024。
    "target": "ES2024",
    // Node 全局类型。
    "types": ["node"],
    // 类型导入必须写 import type。
    "verbatimModuleSyntax": true
  },
  // 输入 = 服务端代码 server/、脚本 scripts/、与面板共享的 src/shared.ts。
  "include": ["server", "scripts", "src/shared.ts"]
}
