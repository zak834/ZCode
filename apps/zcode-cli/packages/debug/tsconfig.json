{
  "compilerOptions": {
    // 允许用「默认导入」的写法引用只有具名导出的模块（类型层面不做报错）
    "allowSyntheticDefaultImports": true,
    // 启用 CommonJS/ESM 互操作语义（default 导入、__importStar 等编译辅助）
    "esModuleInterop": true,
    // 强制 import 路径大小写与真实文件名一致，避免跨平台（尤其 Windows）构建差异
    "forceConsistentCasingInFileNames": true,
    // 保证每个文件可被独立转译（与 Vite 内置的 esbuild 转译兼容）
    "isolatedModules": true,
    // 使用 React 17+ 的自动 JSX 转换（无需在每个文件 import React）
    "jsx": "react-jsx",
    // 可用类型：浏览器 DOM API + DOM 迭代器 + ES2024 标准库（调试面板跑在浏览器里）
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    // 交给打包器处理模块语法，源码按最新 ESM 写法书写
    "module": "ESNext",
    // 按打包器（Vite/esbuild）的解析策略查找模块，支持裸包名导入
    "moduleResolution": "Bundler",
    // 只做类型检查，不产出编译文件——JS 打包由 Vite 负责
    "noEmit": true,
    // 禁止 switch 中贯穿到下一个 case（漏写 break 即报错）
    "noFallthroughCasesInSwitch": true,
    // 索引访问（obj[key]、arr[i]）默认带 undefined，强制判空后再使用
    "noUncheckedIndexedAccess": true,
    // 允许 import JSON 文件并推导其类型
    "resolveJsonModule": true,
    // 跳过对 node_modules 中第三方 .d.ts 的类型检查，加快编译
    "skipLibCheck": true,
    // 开启全部严格类型检查（strictNullChecks、noImplicitAny 等）
    "strict": true,
    // 编译产物的 JS 语法级别为 ES2024
    "target": "ES2024",
    // 引入 Vite 的客户端特殊类型（import.meta.env、资源导入等能力声明）
    "types": ["vite/client"],
    // 强制 import/export 的类型写法与运行时一致（类型导入必须用 import type）
    "verbatimModuleSyntax": true
  },
  // 类型检查覆盖 src 源码目录和 Vite 配置文件
  "include": ["src", "vite.config.ts"]
}
