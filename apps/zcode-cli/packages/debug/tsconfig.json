{
  // ============================================================================
  // debug 包的【调试面板（浏览器端）】配置。面板是一个跑在浏览器/Vite 里的
  // 前端应用，与同目录 tsconfig.server.json（Node 服务端）刻意分开。
  // 嵌套 workspace 独立配置，不继承根基座。
  // ============================================================================
  "compilerOptions": {
    // 允许在类型层面写默认导入（搭配 esModuleInterop 使用）。
    "allowSyntheticDefaultImports": true,
    // 补齐 CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写与文件名强制一致。
    "forceConsistentCasingInFileNames": true,
    // 每个文件可被 Vite 的 esbuild 独立转译。
    "isolatedModules": true,
    // React 自动 JSX 转换，组件无需 import React。
    "jsx": "react-jsx",
    // 浏览器三件套类型：DOM API、可迭代 DOM 集合、ES2024 标准库。
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    // 模块语法保持最新 ESM，交给 Vite/rollup 打包。
    "module": "ESNext",
    // 按打包器规则解析：可省略扩展名、裸包名导入，与 Vite 实际行为一致。
    "moduleResolution": "Bundler",
    // 只查错不产物——面板 JS 由 Vite 打包生成。
    "noEmit": true,
    // switch 漏 break 贯穿时报错。
    "noFallthroughCasesInSwitch": true,
    // 下标访问结果带 undefined，强制判空。
    "noUncheckedIndexedAccess": true,
    // 允许 import json 并推导其类型。
    "resolveJsonModule": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // 全套严格类型检查。
    "strict": true,
    // 产物语法目标 ES2024（现代浏览器直接支持）。
    "target": "ES2024",
    // 加载 Vite 客户端类型：import.meta.env、?url/?.css 等资源导入声明。
    "types": ["vite/client"],
    // 类型导入必须写 import type，保证与 esbuild 单文件转译行为一致。
    "verbatimModuleSyntax": true
  },
  // 检查面板源码目录与 Vite 配置文件本身。
  "include": ["src", "vite.config.ts"]
}
