{
  // ============================================================================
  // contracts 包（模块间交互的契约/接口定义，强调可运行时校验的 schema 边界）
  // 的 TS 配置。嵌套 workspace 独立配置，不继承根基座；纯契约类型包，
  // 只发射声明到 dist-types。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 声明产物目录（与 JS 产物目录分开）。
    "outDir": "./dist-types",
    "rootDir": "./src",
    "declaration": true, // 生成 .d.ts
    "declarationMap": true, // 生成 .d.ts.map
    // 只输出声明、不输出 JS：契约包消费的是类型与 schema，运行时代码由打包带走。
    "emitDeclarationOnly": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖、两类产物目录与测试代码。
  "exclude": ["node_modules", "dist", "dist-types", "test"]
}
