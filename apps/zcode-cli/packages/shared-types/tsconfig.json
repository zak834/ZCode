{
  // ============================================================================
  // shared-types 包（CLI 各模块共享的纯类型定义）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座。它是【纯类型包】：
  // 只发射 .d.ts 声明到 dist-types，不产 JS（JS 由打包工具另行处理）。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 类型声明产物目录（特意与 JS 产物目录 dist 区分开）。
    "outDir": "./dist-types",
    "rootDir": "./src",
    "declaration": true, // 生成 .d.ts
    "declarationMap": true, // 生成 .d.ts.map
    // emitDeclarationOnly：本次编译【只输出声明文件】，不输出 JS。
    // 纯类型包的价值就是给别人 import type，运行时代码由消费方打包带走。
    "emitDeclarationOnly": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除：依赖目录、JS 产物、声明产物、测试代码都不参与本次声明构建。
  "exclude": ["node_modules", "dist", "dist-types", "test"]
}
