{
  // ============================================================================
  // browser-use-plugin 包（浏览器自动化能力插件）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座；只发射类型声明到 dist-types。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 声明产物目录。
    "outDir": "./dist-types",
    "rootDir": "./src",
    "declaration": true, // 生成 .d.ts
    "declarationMap": true, // 生成 .d.ts.map
    // 只输出声明、不输出 JS，运行时代码由插件加载/打包流程处理。
    "emitDeclarationOnly": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖、两类产物目录与测试代码。
  "exclude": ["node_modules", "dist", "dist-types", "test"]
}
