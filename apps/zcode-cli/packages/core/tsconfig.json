{
  // ============================================================================
  // core 包（CLI 的核心 agent loop 与会话逻辑）的 TS 配置。
  // 嵌套 workspace 独立配置，不继承根基座；标准 Node 库包。
  // ============================================================================
  "compilerOptions": {
    // Node 最新 ESM 模块规则与解析规则。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 产物目录与源码根目录。
    "outDir": "./dist",
    "rootDir": "./src",
    // 生成类型声明及声明映射。
    "declaration": true,
    "declarationMap": true,
    // CommonJS 默认导出互操作。
    "esModuleInterop": true,
    // 导入路径大小写强制一致。
    "forceConsistentCasingInFileNames": true,
    // 全套严格类型检查。
    "strict": true,
    // 跳过第三方声明检查。
    "skipLibCheck": true,
    // Node 全局类型。
    "types": ["node"]
  },
  // 编译 src 下所有 TS 文件。
  "include": ["src/**/*"],
  // 排除依赖、产物，以及所有 *.test.ts 测试文件：
  // 单测由专门的测试运行器（带自己的转译/类型环境）处理，不进发布产物。
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
