{
  // ============================================================================
  // prompt-trajectory 工具（提示词轨迹处理脚本）的 TS 配置。
  // 嵌套 workspace 内独立配置，不继承根基座；脚本由运行时直接执行 TS，
  // tsc 只负责类型检查。
  // ============================================================================
  "compilerOptions": {
    // 按 Node.js 最新 ESM 规则组织模块与查找文件（相对导入要带 .js 后缀）。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 只做类型查错，不产出 JS——脚本通过 TS 运行时/加载器直接执行。
    "noEmit": true,
    // 补齐 CommonJS 依赖的默认导出互操作，允许 import x from 'cjs-pkg'。
    "esModuleInterop": true,
    // 强制导入路径大小写与磁盘一致，避免 Windows 写、Linux 跑时找不到模块。
    "forceConsistentCasingInFileNames": true,
    // 开启全套严格类型检查。
    "strict": true,
    // 跳过第三方 .d.ts 检查，加快速度。
    "skipLibCheck": true,
    // 加载 Node 全局类型（process、Buffer 等）。
    "types": ["node"]
  },
  // 检查 src 下所有 TS 文件。
  "include": ["src/**/*"]
}
